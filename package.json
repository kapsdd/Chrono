{
  "name": "chrono",
  "version": "3.2.1",
  "private": true,
  "description": "CHRONO — premium dark-green glassmorphism task manager (Phase 1: web core)",
  "author": "CHRONO",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve out",
    "electron": "electron .",
    "app:dev": "next build && electron .",
    "dist": "next build && electron-builder",
    "dist:linux": "next build && electron-builder --linux",
    "dist:linux:deb": "next build && electron-builder --linux deb",
    "dist:linux:appimage": "next build && electron-builder --linux AppImage",
    "dist:linux:rpm": "next build && electron-builder --linux rpm",
    "dist:all": "next build && electron-builder --win --linux",
    "package:win": "next build && electron-packager . CHRONO --platform=win32 --arch=x64 --out=release --overwrite --asar --prune=false --ignore=\"/node_modules\" --ignore=\"/(src|prisma|shablon|knopki|release|\\.next|\\.claude)\" --ignore=\"\\.(ts|tsx|tsbuildinfo|log)$\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "framer-motion": "^11.15.0",
    "github": "^14.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.chrono.app",
    "productName": "CHRONO",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "okno/icon.png",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraFiles": [
      { "from": ".env", "to": ".env" }
    ],
    "win": {
      "target": "nsis",
      "icon": "okno/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CHRONO",
      "installerIcon": "okno/icon.ico",
      "uninstallerIcon": "okno/icon.ico",
      "runAfterFinish": true,
      "artifactName": "CHRONO-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        { "target": "deb", "arch": ["x64", "arm64"] },
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] }
      ],
      "icon": "okno/icon.png",
      "category": "Office",
      "executableName": "chronotasks",
      "description": "CHRONO — premium dark-green glassmorphism task manager",
      "desktop": {
        "Name": "CHRONO",
        "GenericName": "Task Manager",
        "Comment": "Premium task manager",
        "StartupWMClass": "chronotasks",
        "Keywords": "tasks;todo;planner;productivity;"
      },
      "artifactName": "CHRONO-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0"],
      "packageCategory": "Office",
      "priority": "optional",
      "maintainer": "CHRONO <chrono@example.com>"
    },
    "rpm": {
      "depends": ["gtk3", "libnotify", "nss", "libXScrnSaver", "libXtst", "xdg-utils", "at-spi2-core", "libuuid", "libsecret"]
    },
    "appImage": {}
  }
}
